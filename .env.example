# Veritabanı: yerelde dosya, yayında Turso adresi (libsql://...)
DATABASE_URL=file:local.db
# Sadece Turso için gerekli
DATABASE_AUTH_TOKEN=

# Uygulamaya giriş şifresi. Boş bırakılırsa giriş istenmez (sadece yerel geliştirme için).
APP_PASSWORD=
# Oturum çerezini imzalamak için uzun rastgele bir metin
AUTH_SECRET=degistir-bunu-uzun-rastgele-bir-metinle
